# ─── Database ────────────────────────────────────────────────
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass
POSTGRES_DB=fraud_db
DATABASE_URL=postgresql://fraud_user:fraud_pass@localhost:5432/fraud_db

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Redis Streams (replaces Kafka) ───────────────────────────
REDIS_STREAM_RAW=transactions.raw
REDIS_STREAM_SCORED=transactions.scored
REDIS_CONSUMER_GROUP=fraud-scorer
REDIS_CONSUMER_NAME=fraud-scorer-1

# ─── Kafka (legacy - use Redis Streams instead) ──────────────
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_TOPIC_RAW=transactions.raw
# KAFKA_TOPIC_SCORED=transactions.scored
# KAFKA_TOPIC_ALERTS=fraud.alerts
# KAFKA_CONSUMER_GROUP=fraud-scorer

# ─── ML Model ────────────────────────────────────────────────
MODEL_PATH=models/xgb_fraud_v1.joblib
FRAUD_SCORE_THRESHOLD=0.4

# ─── App ─────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-random-string-in-production
API_PORT=8000
